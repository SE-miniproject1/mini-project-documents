# Copy to .env and export, or set these in your shell. Never commit a real .env.
BBMS_ENV=development            # development | test | production
DJANGO_DEBUG=true               # defaults to true only in development
DJANGO_SECRET_KEY=              # required when not in development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production database (SRS OE-3). Leave unset to use SQLite.
# DB_ENGINE=postgres
# DB_NAME=bbms
# DB_USER=bbms
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
